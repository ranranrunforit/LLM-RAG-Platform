# =============================================================================
# Environment Configuration Template - Project 303 LLM RAG Platform
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Google Colab usage:
#   import os
#   os.environ["GOOGLE_API_KEY"] = "your-key"
#   os.environ["LLM_BACKEND"] = "gemini"
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# LLM Backend Selection
# Options: gemini | vllm
# ─────────────────────────────────────────────────────────────────────────────
LLM_BACKEND=gemini

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini Pro (Primary Backend)
# Get your API key: https://aistudio.google.com/app/apikey
#
# Available models (as of Feb 2026):
#   gemini-2.0-flash            ← fast, free quota friendly
#   gemini-2.0-pro-exp-02-05   ← most capable (Google Pro account)
#   gemini-1.5-pro              ← stable previous gen
#   gemini-1.5-flash            ← stable flash previous gen
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────────
# HuggingFace Embedding Model (same as original architecture)
# bge-small-en-v1.5  → 384 dims, <500MB  ← recommended for Colab free tier
# bge-base-en-v1.5   → 768 dims, ~900MB
# bge-large-en-v1.5  → 1024 dims, ~1.3GB ← original architecture default
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─────────────────────────────────────────────────────────────────────────────
# Vector Database (Qdrant)
# Local/Docker: QDRANT_HOST=localhost
# GKE:          QDRANT_HOST=qdrant-service.llm-inference.svc.cluster.local
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=enterprise_knowledge

# ─────────────────────────────────────────────────────────────────────────────
# API Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# API Key for the REST service (leave empty to disable auth in dev)
API_KEY=

# CORS Origins (comma-separated, use * for all)
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# Safety Guardrails
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_PII_DETECTION=true
ENABLE_CONTENT_MODERATION=false   # Set true if transformers installed
ENABLE_RERANKING=true
RATE_LIMIT_RPM=60

# ─────────────────────────────────────────────────────────────────────────────
# vLLM (Self-Hosted - Optional)
# Deploy vLLM on a GCP VM with GPU, then set this endpoint.
# For Colab Pro+ with A100, you can run vLLM locally on the notebook GPU.
# ─────────────────────────────────────────────────────────────────────────────
# VLLM_ENDPOINT=http://your-gcp-vm-ip:8000/v1
# VLLM_MODEL=llama-3-70b
# LLM_BACKEND=vllm

# ─────────────────────────────────────────────────────────────────────────────
# GCP (for Cloud Run and GCS integration)
# ─────────────────────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
# GCS_BUCKET=your-documents-bucket
